# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)

# Keep the temporary *.pages.dev copy out of Google while bigplayatl.com still runs the old site.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Fingerprinted build assets never change — cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, video, fonts and brand images: cache for a week; browsers revalidate after.
/photos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/video/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
